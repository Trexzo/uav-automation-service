[Unit]
Description=UAV automation and market-data service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uavsvc
Group=uavsvc
WorkingDirectory=/opt/uav-automation-service
EnvironmentFile=/etc/uav-automation-service/service.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/uav-automation-service/.venv/bin/uav-service
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/uav-automation-service

[Install]
WantedBy=multi-user.target
