# Discord application
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=0
SOURCE_CHANNEL_ID=0
CONTROL_CHANNEL_ID=0
OWNER_USER_ID=0
COMMAND_PREFIX=!

# Public code loads deployment-specific matching from this untracked file.
PROFILE_PATH=./config/profile.json

# Runtime storage
DATA_DIR=./data
STATE_DIR=./runtime

# Optional market-data ingestion
SCRAPER_ENABLED=false
SCRAPER_WORKERS=2
SCRAPER_MAX_WORKERS=4
POLLING_INTERVAL=60
TRACKING_INTERVAL=60
MARKET_DATA_URL=

# Optional authenticated local API
API_ENABLED=false
API_HOST=127.0.0.1
API_PORT=8080
API_TOKEN=
API_CORS_ORIGINS=

# Example route destinations referenced by profile.example.json
WEBHOOK_ROUTE_PRIMARY=
WEBHOOK_ROUTE_SECONDARY=
WEBHOOK_ROUTE_CONTROL=
ROLE_ROUTE_PRIMARY=
ROLE_ROUTE_SECONDARY=

WEBHOOK_QUEUE_SIZE=500
LOG_LEVEL=INFO
TZ=UTC
